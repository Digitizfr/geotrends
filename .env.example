# Réglages de GeoTrends. Copier ce fichier vers « .env » et le remplir
# (le script ./installer.sh le fait pour vous). Le fichier .env contient vos
# clés : il ne doit JAMAIS être publié ni envoyé dans un dépôt.
#
# Après un changement : docker compose up -d   (l'outil redémarre avec les nouvelles valeurs)

# ── 1. Indispensable ────────────────────────────────────────────────────────

# L'adresse exacte que vous tapez dans le navigateur pour ouvrir l'outil.
#   sur votre ordinateur :      http://localhost:3010
#   avec un nom de domaine :    https://geo.exemple.fr
BETTER_AUTH_URL="http://localhost:3010"

# Deux secrets propres à votre installation. À générer une fois, puis à ne plus changer :
#   openssl rand -base64 32     pour BETTER_AUTH_SECRET
#   openssl rand -hex 24        pour POSTGRES_PASSWORD (lettres et chiffres seulement)
BETTER_AUTH_SECRET=""
POSTGRES_PASSWORD=""

# DataForSEO : les relevés de ChatGPT, Gemini, du Mode IA et des Aperçus IA de Google.
# Environ 0,0012 $ par réponse relevée, payé à l'usage (recharge minimale de 50 $).
# Identifiant et mot de passe d'API : https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# ── 2. Conseillé : le petit modèle qui lit les réponses ─────────────────────
# Il repère les marques nommées, leur rang et le ton, étiquette les questions et
# classe les sites. Moins d'un millième de dollar par réponse. Une seule des deux
# clés suffit ; si les deux sont là, DeepSeek est utilisé (le moins cher).

# DeepSeek : https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""

# Anthropic : https://console.anthropic.com/settings/keys
# Sert aussi à relever Claude (environ 0,06 $ par question avec Sonnet).
ANTHROPIC_API_KEY=""

# ── 3. Facultatif ───────────────────────────────────────────────────────────

# YouTube (gratuit) : le nom de la chaîne de chaque vidéo citée.
# Clé « YouTube Data API v3 » : https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=""

# Resend (gratuit jusqu'à 3 000 e-mails par mois) : le rapport du lundi par e-mail.
# Clé : https://resend.com/api-keys   L'adresse d'expédition doit être sur un domaine vérifié chez Resend.
RESEND_API_KEY=""
RAPPORT_EXPEDITEUR=""
# Exemple : RAPPORT_EXPEDITEUR="GeoTrends <rapport@exemple.fr>"

# Sur un serveur, avec un nom de domaine (il doit déjà pointer vers le serveur) :
# renseignez DOMAINE, mettez COMPOSE_PROFILES="https" et donnez à BETTER_AUTH_URL
# l'adresse en https. Le certificat HTTPS se fait tout seul.
DOMAINE=""
COMPOSE_PROFILES=""

# ── 4. Réglages avancés (les valeurs par défaut conviennent) ────────────────

# Modèle de Claude interrogé pour les relevés. Prix mesurés pour une question avec
# recherche web : Opus 5.5 environ 0,17 $, Sonnet 5.5 0,06 $, Haiku 5.5 0,02 $.
CLAUDE_MODELE="claude-sonnet-5-5"

# Imposer le petit modèle : « deepseek » ou « anthropic » (sinon : celui dont la clé est là).
# ANALYSE_FOURNISSEUR="deepseek"
# ANALYSE_MODELE="deepseek-flash"

# Port et adresse d'écoute de l'outil sur la machine (Docker).
# GEOTRENDS_PORT="3010"
# GEOTRENDS_ADRESSE="127.0.0.1"

# Base de données (Docker) : nom et utilisateur.
# POSTGRES_USER="geotrends"
# POSTGRES_DB="geotrends"

# Sans Docker (développement) : adresse d'une base PostgreSQL locale.
# DATABASE_URL="postgresql://utilisateur@localhost:5432/geotrends_dev"
